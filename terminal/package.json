{
  "name": "master-us-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Research terminal for the MASTER-US port \u2014 static export, GitHub Pages compatible.",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --port 4173",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "build:single": "node node_modules/vite/bin/vite.js build --config vite.config.single.ts",
    "smoke": "node ./smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
